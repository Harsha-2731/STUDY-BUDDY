<%- include('partials/head', { title: 'My Subjects & Syllabus Tracker', bodyClass: 'app-layout' }) %>

<%- include('partials/sidebar', { activeNav: 'subjects' }) %>

<div class="main-content">
  <%- include('partials/navbar', { pageTitle: 'My Subjects & Syllabus Tracker' }) %>

  <main class="page-container">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
          <span class="badge badge-primary"><%= user.academicBranch || 'CSE' %> &bull; <%= user.academicYear || '1st Year' %></span>
          <span class="badge badge-secondary"><%= user.academicSemester || '1st sem' %></span>
        </div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
          My Subjects &amp; Syllabus Tracker
        </h1>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">
          Track your topic mastery and progress unit-by-unit across your engineering curriculum.
        </p>
      </div>

      <!-- Overall Completion Widget -->
      <div class="card" style="padding: 1rem 1.5rem; display: flex; align-items: center; gap: 1.25rem;">
        <div>
          <div style="font-size: 0.775rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Overall Progress</div>
          <div id="overallProgressDisplay" style="font-size: 1.6rem; font-weight: 800; color: var(--primary); line-height: 1.1;">
            <%= overallCompletion %>%
          </div>
          <div style="font-size: 0.75rem; color: var(--text-light);"><span id="completedTopicsCount"><%= completedCount %></span> topics completed</div>
        </div>
        <div style="width: 54px; height: 54px; border-radius: 50%; border: 4px solid var(--primary-light); border-top-color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--primary);">
          <i class="fas fa-chart-line"></i>
        </div>
      </div>
    </div>

    <!-- Subject Tabs / Accordions -->
    <% if (subjectsData && subjectsData.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
        <% subjectsData.forEach((sub, sIdx) => { %>
          <div class="card" id="subject-card-<%= sIdx %>">
            <div class="card-header" style="background-color: var(--bg-subtle); cursor: pointer;" onclick="toggleAccordion('units-<%= sIdx %>')">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <span class="brand-badge" style="width: 38px; height: 38px; font-size: 1.05rem;"><i class="fas fa-book"></i></span>
                <div>
                  <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.15rem;"><%= sub.subject %></h3>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">
                    <%= sub.units.length %> Units &bull; <%= sub.totalTopics %> Topics &bull; <span style="color: var(--success); font-weight: 600;"><%= sub.completedTopics %> Completed</span>
                  </div>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 120px; height: 8px; background: var(--border-medium); border-radius: 4px; overflow: hidden; display: none; @media(min-width: 640px){display: block;}">
                  <div id="progress-bar-<%= sIdx %>" style="width: <%= sub.totalTopics > 0 ? Math.round((sub.completedTopics / sub.totalTopics) * 100) : 0 %>%; height: 100%; background: linear-gradient(90deg, var(--primary), var(--success)); transition: width 0.3s ease;"></div>
                </div>
                <a href="/resources?subject=<%= encodeURIComponent(sub.subject) %>" class="btn btn-secondary btn-sm" onclick="event.stopPropagation()">
                  <i class="fas fa-folder-open"></i> Notes
                </a>
                <i class="fas fa-chevron-down" id="icon-units-<%= sIdx %>" style="color: var(--text-light); transition: transform 0.25s ease;"></i>
              </div>
            </div>

            <!-- Subject Units Accordion Body -->
            <div id="units-<%= sIdx %>" style="padding: 1.5rem; display: <%= sIdx === 0 ? 'block' : 'none' %>;">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
                <% sub.units.forEach((unit, uIdx) => { %>
                  <div style="border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; background-color: var(--bg-surface);">
                    <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main); border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.5rem; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center;">
                      <span><i class="fas fa-layer-group text-primary"></i> <%= unit.unitName %></span>
                      <span class="badge badge-secondary"><%= unit.topics.length %> Topics</span>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                      <% unit.topics.forEach(t => { %>
                        <label style="display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.85rem; color: var(--text-main); cursor: pointer; user-select: none;">
                          <input type="checkbox" <%= t.isCompleted ? 'checked' : '' %> 
                                 onchange="toggleTopicProgress('<%= sub.subject %>', '<%= unit.unitName %>', '<%= t.topicName %>', this.checked, '<%= sIdx %>')" 
                                 style="margin-top: 0.25rem; accent-color: var(--primary);">
                          <span style="line-height: 1.4; text-decoration: <%= t.isCompleted ? 'line-through' : 'none' %>; color: <%= t.isCompleted ? 'var(--text-muted)' : 'var(--text-main)' %>;">
                            <%= t.topicName %>
                          </span>
                        </label>
                      <% }); %>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="fas fa-book-open"></i></div>
        <h3 class="empty-state-title">No subjects found for current academic profile</h3>
        <p class="empty-state-desc">Update your branch and semester in Profile to see your custom engineering subjects.</p>
        <a href="/profile" class="btn btn-primary">Update Profile</a>
      </div>
    <% } %>
  </main>
</div>

<script>
function toggleAccordion(id) {
  const content = document.getElementById(id);
  const icon = document.getElementById('icon-' + id);
  if (!content) return;
  const isHidden = content.style.display === 'none';
  content.style.display = isHidden ? 'block' : 'none';
  if (icon) {
    icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
  }
}

async function toggleTopicProgress(subject, unit, topic, isCompleted, sIdx) {
  try {
    const res = await fetch('/api/progress', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        subject,
        unit,
        topic,
        status: isCompleted ? 'completed' : 'not_started'
      })
    });
    const data = await res.json();
    if (res.ok) {
      window.showToast(isCompleted ? 'Topic completed! 🎉' : 'Topic marked incomplete', 'success');
      if (typeof data.overallCompletion === 'number') {
        document.getElementById('overallProgressDisplay').textContent = data.overallCompletion + '%';
      }
      if (typeof data.completedCount === 'number') {
        document.getElementById('completedTopicsCount').textContent = data.completedCount;
      }
    } else {
      window.showToast('Failed to update progress', 'error');
    }
  } catch (e) {
    window.showToast('Network error updating progress', 'error');
  }
}
</script>

<%- include('partials/footer') %>
