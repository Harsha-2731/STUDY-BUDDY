<%- include('partials/head', { title: 'Study Planner & Focus Timer', bodyClass: 'app-layout' }) %>

<%- include('partials/sidebar', { activeNav: 'planner' }) %>

<div class="main-content">
  <%- include('partials/navbar', { pageTitle: 'Study Planner & Timer' }) %>

  <main class="page-container">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
          Study Planner &amp; Focus Timer
        </h1>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">
          Organize your revision targets, manage deadlines, and run deep-work Pomodoro sessions.
        </p>
      </div>

      <button type="button" class="btn btn-primary" onclick="openNewTaskModal()">
        <i class="fas fa-plus"></i> Create New Study Task
      </button>
    </div>

    <!-- Top Focus Timer & Study Stats Section -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem; @media(max-width: 900px){grid-template-columns: 1fr;}">
      
      <!-- Interactive Pomodoro Timer Card -->
      <div class="card" id="timer" style="padding: 2rem; text-align: center;">
        <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem;">
          <button type="button" class="btn btn-sm btn-primary" id="modeFocus" onclick="setTimerMode('focus')">
            <i class="fas fa-brain"></i> 25m Focus
          </button>
          <button type="button" class="btn btn-sm btn-secondary" id="modeShort" onclick="setTimerMode('short')">
            <i class="fas fa-coffee"></i> 5m Break
          </button>
          <button type="button" class="btn btn-sm btn-secondary" id="modeLong" onclick="setTimerMode('long')">
            <i class="fas fa-couch"></i> 15m Long Break
          </button>
        </div>

        <div class="timer-dial">
          <div id="plannerTimerDigits" class="timer-digits">25:00</div>
          <div id="plannerTimerLabel" class="timer-label">Focus Session</div>
        </div>

        <div style="display: flex; justify-content: center; gap: 0.75rem; margin-top: 1.5rem;">
          <button id="plannerTimerToggle" type="button" class="btn btn-primary btn-lg" onclick="togglePlannerTimer()">
            <i class="fas fa-play"></i> Start Focus
          </button>
          <button type="button" class="btn btn-secondary btn-icon" onclick="resetPlannerTimer()" title="Reset Timer">
            <i class="fas fa-rotate-right"></i>
          </button>
        </div>
      </div>

      <!-- Study Statistics Card -->
      <div class="card" style="padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div class="card-header" style="padding: 0 0 1rem; margin-bottom: 1rem;">
          <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">Study Focus Analytics</h3>
          <span class="badge badge-success"><i class="fas fa-chart-pie"></i> Real-time</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div style="background-color: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-md); text-align: center;">
            <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Total Focus Time</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--primary); margin: 0.25rem 0;" id="statsTotalMinutes">
              <%= totalFocusMinutes %> min
            </div>
            <div style="font-size: 0.75rem; color: var(--text-light);">Logged Pomodoro work</div>
          </div>

          <div style="background-color: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-md); text-align: center;">
            <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Completed Sessions</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--secondary); margin: 0.25rem 0;" id="statsTotalSessions">
              <%= totalSessionsCount %>
            </div>
            <div style="font-size: 0.75rem; color: var(--text-light);">Focus blocks completed</div>
          </div>
        </div>

        <div style="background-color: var(--bg-subtle); border-radius: var(--radius-md); padding: 1rem; font-size: 0.85rem; color: var(--text-muted);">
          <div style="font-weight: 600; color: var(--text-main); margin-bottom: 0.35rem;">💡 Productivity Tip</div>
          Break down large subjects (e.g. Mathematics or Computer Networks) into 25-minute single-topic units.
        </div>
      </div>
    </div>

    <!-- Study Tasks Kanban / Columns -->
    <div class="card">
      <div class="card-header">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">Active Study Tasks (<%= tasks ? tasks.length : 0 %>)</h3>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="filterTasks('all')">All</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="filterTasks('pending')">Pending</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="filterTasks('completed')">Completed</button>
        </div>
      </div>

      <div class="card-body">
        <% if (tasks && tasks.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.85rem;">
            <% tasks.forEach(task => { %>
              <div class="task-item-card" data-status="<%= task.status %>" id="task-<%= task._id %>" 
                   style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background-color: var(--bg-surface); gap: 1rem;">
                <div style="display: flex; align-items: flex-start; gap: 0.85rem; flex: 1;">
                  <input type="checkbox" <%= task.status === 'completed' ? 'checked' : '' %> 
                         onchange="updateTaskStatus('<%= task._id %>', this.checked)" style="margin-top: 0.25rem; cursor: pointer; accent-color: var(--primary);">
                  <div>
                    <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main); text-decoration: <%= task.status === 'completed' ? 'line-through' : 'none' %>;">
                      <%= task.title %>
                    </div>
                    <% if (task.description) { %>
                      <div style="font-size: 0.825rem; color: var(--text-muted); margin-top: 0.15rem;"><%= task.description %></div>
                    <% } %>
                    <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.35rem; font-size: 0.75rem;">
                      <span class="badge badge-secondary"><i class="fas fa-book"></i> <%= task.subject %></span>
                      <% if (task.priority === 'high') { %>
                        <span class="badge badge-danger">High Priority</span>
                      <% } else if (task.priority === 'low') { %>
                        <span class="badge badge-secondary">Low Priority</span>
                      <% } else { %>
                        <span class="badge badge-warning">Medium Priority</span>
                      <% } %>
                      <% if (task.dueDate) { %>
                        <span style="color: var(--text-muted);"><i class="far fa-calendar"></i> <%= new Date(task.dueDate).toLocaleDateString() %></span>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div style="display: flex; gap: 0.35rem;">
                  <button type="button" class="btn-icon btn-sm" onclick="deleteTask('<%= task._id %>')" title="Delete Task" style="color: var(--danger);">
                    <i class="fas fa-trash-can"></i>
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-icon"><i class="fas fa-calendar-plus"></i></div>
            <h4 class="empty-state-title">No study tasks planned</h4>
            <p class="empty-state-desc">Add revision goals, unit checklists, and assignment deadlines to stay on track.</p>
            <button type="button" class="btn btn-primary btn-sm" onclick="openNewTaskModal()">
              <i class="fas fa-plus"></i> Create First Task
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<!-- Task Modal -->
<div id="taskModal" class="modal-backdrop">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Create Study Task</h3>
      <button type="button" class="btn-icon btn-sm" onclick="closeTaskModal()"><i class="fas fa-times"></i></button>
    </div>
    <form id="createTaskForm" onsubmit="handleCreateTask(event)">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Task Title</label>
          <input type="text" name="title" class="form-control" placeholder="e.g. Solve Unit 2 Calculus Exercises" required>
        </div>
        <div class="form-group">
          <label class="form-label">Description / Notes</label>
          <textarea name="description" class="form-control" rows="2" placeholder="Key topics or pages to cover..."></textarea>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="e.g. M1, DS, Physics" value="General">
          </div>
          <div class="form-group">
            <label class="form-label">Priority</label>
            <select name="priority" class="form-select">
              <option value="medium">Medium</option>
              <option value="high">High</option>
              <option value="low">Low</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Due Date</label>
          <input type="date" name="dueDate" class="form-control">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="closeTaskModal()">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Task</button>
      </div>
    </form>
  </div>
</div>

<script>
// Timer Logic
let currentMode = 'focus';
let plannerDuration = 25 * 60;
let plannerSecondsLeft = 25 * 60;
let plannerTimerInterval = null;
let plannerIsRunning = false;

function setTimerMode(mode) {
  currentMode = mode;
  clearInterval(plannerTimerInterval);
  plannerIsRunning = false;
  document.getElementById('plannerTimerToggle').innerHTML = '<i class="fas fa-play"></i> Start';

  document.getElementById('modeFocus').className = 'btn btn-sm btn-secondary';
  document.getElementById('modeShort').className = 'btn btn-sm btn-secondary';
  document.getElementById('modeLong').className = 'btn btn-sm btn-secondary';

  if (mode === 'focus') {
    plannerDuration = 25 * 60;
    document.getElementById('modeFocus').className = 'btn btn-sm btn-primary';
    document.getElementById('plannerTimerLabel').textContent = 'Focus Session';
  } else if (mode === 'short') {
    plannerDuration = 5 * 60;
    document.getElementById('modeShort').className = 'btn btn-sm btn-primary';
    document.getElementById('plannerTimerLabel').textContent = 'Short Break';
  } else if (mode === 'long') {
    plannerDuration = 15 * 60;
    document.getElementById('modeLong').className = 'btn btn-sm btn-primary';
    document.getElementById('plannerTimerLabel').textContent = 'Long Break';
  }

  plannerSecondsLeft = plannerDuration;
  updateTimerDisplay();
}

function updateTimerDisplay() {
  const m = Math.floor(plannerSecondsLeft / 60);
  const s = plannerSecondsLeft % 60;
  document.getElementById('plannerTimerDigits').textContent = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
}

function togglePlannerTimer() {
  const btn = document.getElementById('plannerTimerToggle');
  if (plannerIsRunning) {
    clearInterval(plannerTimerInterval);
    plannerIsRunning = false;
    btn.innerHTML = '<i class="fas fa-play"></i> Resume';
  } else {
    plannerIsRunning = true;
    btn.innerHTML = '<i class="fas fa-pause"></i> Pause';
    plannerTimerInterval = setInterval(() => {
      plannerSecondsLeft--;
      updateTimerDisplay();
      if (plannerSecondsLeft <= 0) {
        clearInterval(plannerTimerInterval);
        plannerIsRunning = false;
        btn.innerHTML = '<i class="fas fa-play"></i> Start';
        const mins = Math.round(plannerDuration / 60);
        logStudySession(mins, currentMode);
        window.showToast(`🎉 Timer finished! Logged ${mins} minutes.`, 'success');
        resetPlannerTimer();
      }
    }, 1000);
  }
}

function resetPlannerTimer() {
  clearInterval(plannerTimerInterval);
  plannerIsRunning = false;
  plannerSecondsLeft = plannerDuration;
  updateTimerDisplay();
  document.getElementById('plannerTimerToggle').innerHTML = '<i class="fas fa-play"></i> Start';
}

async function logStudySession(minutes, type) {
  try {
    const res = await fetch('/api/study-sessions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ durationMinutes: minutes, sessionType: type })
    });
    if (res.ok) {
      setTimeout(() => window.location.reload(), 1200);
    }
  } catch (e) {
    console.error(e);
  }
}

// Task Handlers
function openNewTaskModal() {
  document.getElementById('taskModal').classList.add('active');
}
function closeTaskModal() {
  document.getElementById('taskModal').classList.remove('active');
}

async function handleCreateTask(e) {
  e.preventDefault();
  const formData = new FormData(e.target);
  const payload = {
    title: formData.get('title'),
    description: formData.get('description'),
    subject: formData.get('subject'),
    priority: formData.get('priority'),
    dueDate: formData.get('dueDate') || null
  };

  try {
    const res = await fetch('/api/tasks', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (res.ok) {
      window.showToast('Task added successfully!', 'success');
      closeTaskModal();
      setTimeout(() => window.location.reload(), 500);
    } else {
      window.showToast('Failed to create task', 'error');
    }
  } catch (e) {
    window.showToast('Network error', 'error');
  }
}

async function updateTaskStatus(id, checked) {
  try {
    const res = await fetch(`/api/tasks/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: checked ? 'completed' : 'pending' })
    });
    if (res.ok) {
      window.showToast(checked ? 'Task marked complete' : 'Task pending', 'success');
      setTimeout(() => window.location.reload(), 400);
    }
  } catch (e) {
    window.showToast('Error updating task', 'error');
  }
}

async function deleteTask(id) {
  if (!confirm('Delete this task?')) return;
  try {
    const res = await fetch(`/api/tasks/${id}`, { method: 'DELETE' });
    if (res.ok) {
      document.getElementById(`task-${id}`)?.remove();
      window.showToast('Task deleted', 'info');
    }
  } catch (e) {
    window.showToast('Error deleting task', 'error');
  }
}

function filterTasks(status) {
  const items = document.querySelectorAll('.task-item-card');
  items.forEach(item => {
    if (status === 'all' || item.getAttribute('data-status') === status) {
      item.style.display = 'flex';
    } else {
      item.style.display = 'none';
    }
  });
}
</script>

<%- include('partials/footer') %>
