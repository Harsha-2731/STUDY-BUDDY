<%- include('partials/head', { title: 'Upload Study Materials — StudyBuddy', bodyClass: 'app-layout' }) %>

<%- include('partials/sidebar', { activeNav: 'upload' }) %>

<div class="main-content">
  <%- include('partials/navbar', { pageTitle: 'Upload Study Materials' }) %>

  <main class="page-container">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
      <div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); line-height: 1.2;">
          Upload Study Materials
        </h1>
        <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.25rem;">
          Share your class notes, solved papers, and reference documents with your student workspace.
        </p>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem; @media(max-width: 900px){grid-template-columns: 1fr;}">
      
      <!-- Upload Form Card -->
      <div class="card" style="padding: 2rem;">
        <div class="card-header" style="padding: 0 0 1rem; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">Upload Document</h3>
          <span class="badge badge-primary">Max 10MB</span>
        </div>

        <form id="uploadForm" enctype="multipart/form-data" onsubmit="handleFileUpload(event)">
          <div class="form-group">
            <label class="form-label">Material Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Unit 3 Trees & Graphs Handwritten Notes" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Subject</label>
              <input type="text" name="subject" class="form-control" placeholder="e.g. Data Structures" required>
            </div>
            <div class="form-group">
              <label class="form-label">Curriculum Unit</label>
              <input type="text" name="unit" class="form-control" placeholder="e.g. 3rd unit" value="1st unit">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Branch</label>
              <select name="branch" class="form-select">
                <option value="CSE">CSE</option>
                <option value="AIML">AIML</option>
                <option value="AIDS">AIDS</option>
                <option value="IT">IT</option>
                <option value="CSIT">CSIT</option>
                <option value="CIC">CIC</option>
                <option value="ECE">ECE</option>
                <option value="EEE">EEE</option>
                <option value="MECH">MECH</option>
                <option value="CIVIL">CIVIL</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Academic Year</label>
              <select name="year" class="form-select">
                <option value="1st Year">1st Year</option>
                <option value="2nd Year">2nd Year</option>
                <option value="3rd Year">3rd Year</option>
                <option value="4th Year">4th Year</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Description (Optional)</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Brief summary of what this document covers..."></textarea>
          </div>

          <!-- File Input Drop Area -->
          <div class="form-group">
            <label class="form-label">Select File (PDF, Image, Text)</label>
            <div style="border: 2px dashed var(--border-medium); border-radius: var(--radius-lg); padding: 2rem 1rem; text-align: center; background-color: var(--bg-subtle); cursor: pointer;" onclick="document.getElementById('fileInput').click()">
              <i class="fas fa-cloud-arrow-up" style="font-size: 2.25rem; color: var(--primary); margin-bottom: 0.75rem;"></i>
              <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main);">Click to browse files or drag here</div>
              <div style="font-size: 0.775rem; color: var(--text-muted); margin-top: 0.25rem;">Supported formats: PDF, JPEG, PNG, TXT</div>
              <input type="file" id="fileInput" name="file" style="display: none;" required onchange="handleFileSelected(this)">
              <div id="selectedFileName" style="margin-top: 0.75rem; font-weight: 600; color: var(--primary); font-size: 0.85rem;"></div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary" id="uploadSubmitBtn" style="width: 100%;">
            <i class="fas fa-upload"></i> Upload &amp; Save Material
          </button>
        </form>
      </div>

      <!-- Guidelines & Info Card -->
      <div class="card" style="padding: 2rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div class="card-header" style="padding: 0 0 1rem; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">Upload Guidelines</h3>
          </div>
          <div style="display: flex; flex-direction: column; gap: 1rem; font-size: 0.9rem; color: var(--text-muted);">
            <div style="display: flex; gap: 0.75rem;">
              <i class="fas fa-check-circle text-success" style="margin-top: 0.25rem;"></i>
              <div>
                <strong style="color: var(--text-main);">High Resolution Scans:</strong> Ensure handwriting or typed text is clearly legible when photographing notebook pages.
              </div>
            </div>

            <div style="display: flex; gap: 0.75rem;">
              <i class="fas fa-check-circle text-success" style="margin-top: 0.25rem;"></i>
              <div>
                <strong style="color: var(--text-main);">Accurate Subject &amp; Unit:</strong> Proper labeling helps other students in your branch find your materials quickly.
              </div>
            </div>

            <div style="display: flex; gap: 0.75rem;">
              <i class="fas fa-check-circle text-success" style="margin-top: 0.25rem;"></i>
              <div>
                <strong style="color: var(--text-main);">Privacy &amp; Safety:</strong> Do not upload documents containing sensitive personal information or passwords.
              </div>
            </div>
          </div>
        </div>

        <div style="background-color: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-md); border-left: 4px solid var(--primary); margin-top: 2rem;">
          <div style="font-weight: 700; color: var(--text-main); font-size: 0.9rem;">Need cloud sharing instead?</div>
          <p style="font-size: 0.825rem; color: var(--text-muted); margin-top: 0.25rem;">
            If you have a Google Drive folder or YouTube lecture playlist, you can add it directly through the Admin / Resource links.
          </p>
        </div>
      </div>
    </div>

    <!-- Your Uploads History Table -->
    <div class="card">
      <div class="card-header">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main);">My Uploaded Materials</h3>
        <span class="badge badge-secondary"><%= upload ? upload.length : 0 %> items</span>
      </div>

      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Subject</th>
              <th>Type</th>
              <th>Uploaded Date</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (upload && upload.length > 0) { %>
              <% upload.forEach(item => { %>
                <tr id="upload-row-<%= item._id %>">
                  <td style="font-weight: 600;"><%= item.title %></td>
                  <td><span class="badge badge-secondary"><%= item.subject || 'General' %></span></td>
                  <td>
                    <span class="badge badge-primary">
                      <i class="fas <%= item.fileType === 'pdf' ? 'fa-file-pdf' : (item.fileType === 'image' ? 'fa-file-image' : 'fa-file-alt') %>"></i>
                      <%= (item.fileType || 'file').toUpperCase() %>
                    </span>
                  </td>
                  <td style="font-size: 0.825rem; color: var(--text-muted);">
                    <%= new Date(item.createdAt).toLocaleDateString() %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 0.5rem;">
                      <a href="/upload/<%= item.filename %>" target="_blank" class="btn btn-secondary btn-sm">
                        <i class="fas fa-eye"></i> View
                      </a>
                      <button type="button" class="btn btn-danger btn-sm" onclick="deleteUserUpload('<%= item._id %>')">
                        <i class="fas fa-trash-can"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  No files uploaded yet. Use the form above to add your first study note.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
function handleFileSelected(input) {
  if (input.files && input.files[0]) {
    const file = input.files[0];
    document.getElementById('selectedFileName').textContent = `Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
  }
}

async function handleFileUpload(e) {
  e.preventDefault();
  const form = e.target;
  const formData = new FormData(form);
  const btn = document.getElementById('uploadSubmitBtn');

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading file...';

  try {
    const res = await fetch('/upload/upload', {
      method: 'POST',
      body: formData
    });
    const data = await res.json();
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-upload"></i> Upload &amp; Save Material';

    if (res.ok && data.success) {
      window.showToast('Material uploaded successfully!', 'success');
      setTimeout(() => window.location.reload(), 600);
    } else {
      window.showToast(data.error || 'Upload failed', 'error');
    }
  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-upload"></i> Upload &amp; Save Material';
    window.showToast('Network error during upload', 'error');
  }
}

async function deleteUserUpload(id) {
  if (!confirm('Delete this uploaded file?')) return;
  try {
    const res = await fetch(`/upload/${id}`, { method: 'DELETE' });
    if (res.ok) {
      document.getElementById(`upload-row-${id}`)?.remove();
      window.showToast('File deleted successfully', 'info');
    } else {
      window.showToast('Failed to delete file', 'error');
    }
  } catch (e) {
    window.showToast('Network error', 'error');
  }
}
</script>

<%- include('partials/footer') %>